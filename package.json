{
  "name": "juying-tv",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "聚影 TV - 桌面端与 Android 影视聚合播放器",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,APP -c cyan,magenta \"vite\" \"npm:dev:app\"",
    "dev:app": "wait-on tcp:5173 && npm run build:main && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:main": "node scripts/build-main.mjs",
    "build:web": "vite build",
    "build": "npm run build:web && npm run build:main",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "e2e:packaged": "node scripts/e2e-packaged.mjs",
    "icon": "python scripts/make-icon.py",
    "android:prepare": "node scripts/prepare-android.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "artplayer": "^5.4.0",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.74.0",
    "mpegts.js": "^1.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
